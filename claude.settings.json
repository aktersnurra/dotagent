{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Read(**/.env*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(awk *.env*)",
      "Bash(sed *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "Bash(strings *.env*)",
      "Bash(base64 *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(export -p*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secret-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for secret exposure..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"session_end\": true}' >> ~/.claude/session.log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "hegel-skill@hegeldev": true
  },
  "extraKnownMarketplaces": {
    "hegeldev": {
      "source": {
        "source": "github",
        "repo": "hegeldev/hegel-skill"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/.local/share/wiki",
        "~/projects/dotagent/.jj",
        "~/projects/dotagent/.git"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.vault-token",
        "~/.password-store"
      ]
    }
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}

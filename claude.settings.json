{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Read(**/.env*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(awk *.env*)",
      "Bash(sed *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "Bash(strings *.env*)",
      "Bash(base64 *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(export -p*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secret-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for secret exposure..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"session_end\": true}' >> ~/.claude/session.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude\" && echo \"$(date): wrote $CLAUDE_FILE_PATHS\" >> \"$CLAUDE_PROJECT_DIR/.claude/writes.log\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context compacting — writing session state...' && touch \"$CLAUDE_PROJECT_DIR/.claude/writes.log\" && cat \"$CLAUDE_PROJECT_DIR/.claude/writes.log\" >> \"$CLAUDE_PROJECT_DIR/SESSION_SUMMARY.md\" && : > \"$CLAUDE_PROJECT_DIR/.claude/writes.log\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@superpowers-dev": true,
    "hegel-skill@hegeldev": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/aktersnurra/superpowers.git"
      }
    },
    "hegeldev": {
      "source": {
        "source": "github",
        "repo": "hegeldev/hegel-skill"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.vault-token",
        "~/.password-store"
      ]
    }
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim"
}

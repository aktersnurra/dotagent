{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "types": []
  },
  "include": ["src"]
}

#!/bin/sh
# Regenerate the wiki screening index from page frontmatter.
#
# Reads only each page's frontmatter block, so example frontmatter quoted
# inside fenced code blocks in a page body never leaks into the index.
# Writes $WIKI_HOME/.index.md — a dotfile, so the sync path's *.md glob
# keeps excluding it from the encrypted archive.
#
# Usage: reindex [wiki_home]

set -eu

WIKI_HOME="${1:-${XDG_DATA_HOME:-$HOME/.local/share}/wiki}"

[ -d "$WIKI_HOME" ] || { echo "reindex: no such directory: $WIKI_HOME" >&2; exit 1; }

index="$WIKI_HOME/.index.md"
tmp="$index.tmp.$$"

{
	echo "# Wiki index"
	echo
	echo "<!-- Generated by skills/wiki/reindex. Do not edit by hand. -->"
	echo
	echo "| Page | Type | Date | Tags | Description |"
	echo "|------|------|------|------|-------------|"

	for page in "$WIKI_HOME"/*.md; do
		[ -e "$page" ] || continue
		awk -v fn="$(basename "$page")" '
			NR == 1 && /^---$/ { inb = 1; next }
			inb && /^---$/     { exit }
			inb {
				colon = index($0, ":")
				if (colon == 0) next
				k = substr($0, 1, colon - 1)
				v = substr($0, colon + 2)
				if      (k == "title")       t  = v
				else if (k == "date")        d  = v
				else if (k == "type")        ty = v
				else if (k == "description") de = v
				else if (k == "tags")        { gsub(/^\[|\]$/, "", v); tg = v }
			}
			END {
				if (t == "") t = fn
				gsub(/\|/, "\\|", t)
				gsub(/\|/, "\\|", de)
				gsub(/\|/, "\\|", tg)
				if (length(de) > 110) de = substr(de, 1, 110) "…"
				printf "| [%s](%s) | %s | %s | %s | %s |\n", t, fn, ty, d, tg, de
			}
		' "$page"
	done
} >"$tmp"

mv "$tmp" "$index"
chmod 600 "$index"

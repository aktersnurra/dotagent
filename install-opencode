#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$HOME/projects/dotagent"
OPENCODE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

mkdir -p "$OPENCODE/skills"

ln -sf "$DOTFILES/CLAUDE.md" "$OPENCODE/CLAUDE.md"

"$DOTFILES/install-skills" "$DOTFILES/skills" "$OPENCODE/skills"

echo "Opencode configured."

#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PI="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
provider=""

usage() {
  echo "usage: install-pi [--dir <path>] [--provider <provider-id>]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir)
      if [[ $# -lt 2 ]]; then
        usage
        exit 2
      fi
      PI="$2"
      shift 2
      ;;
    --provider)
      if [[ $# -lt 2 ]]; then
        usage
        exit 2
      fi
      provider="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

link_directory() {
  local source="$1"
  local target="$2"

  if [[ -L "$target" ]]; then
    local current
    current="$(readlink "$target")"
    if [[ "$current" == "$source" ]]; then
      return 0
    fi
    printf 'Refusing to replace symlink: %s -> %s\nExpected: %s\n' \
      "$target" "$current" "$source" >&2
    return 1
  fi

  if [[ -e "$target" ]]; then
    printf 'Refusing to replace existing path: %s\n' "$target" >&2
    return 1
  fi

  ln -s "$source" "$target"
}

mkdir -p "$PI/skills" "$PI/prompts" "$PI/extensions"

ln -sf "$DOTFILES/AGENTS.md" "$PI/AGENTS.md"

link_directory \
  "$DOTFILES/pi/extensions/pi-skill-visibility" \
  "$PI/extensions/pi-skill-visibility"

"$DOTFILES/install-skills" "$DOTFILES/skills" "$PI/skills"

for command in "$DOTFILES/commands"/*.md; do
  [[ -e "$command" ]] || continue
  ln -sf "$command" "$PI/prompts/$(basename "$command")"
done

PI_PACKAGES=(
  "npm:@ff-labs/pi-fff"
  "npm:context-mode"
  "npm:pi-subagents"
  "npm:pi-mcp-adapter"
  "npm:pi-lens"
  "npm:pi-ask-user"
  "npm:@tintinweb/pi-tasks"
  "npm:pi-hermes-memory"
  "git:github.com/aktersnurra/pi-vim"
  "git:github.com/aktersnurra/superpowers"
  "git:github.com/aktersnurra/no-clown-fiesta.pi@master"
)

PI_THEME="no-clown-fiesta-dark"

SETTINGS="$PI/settings.json"
echo "Installing Pi packages..."
if [[ -f "$SETTINGS" ]]; then
  if grep -qF '"npm:@casualjim/pi-superpowers"' "$SETTINGS"; then
    echo "  removing official superpowers package"
    PI_CODING_AGENT_DIR="$PI" pi remove "npm:@casualjim/pi-superpowers"
  fi
  if grep -qF '"/home/aktersnurra/projects/vibe/superpowers"' "$SETTINGS"; then
    echo "  removing local superpowers package"
    PI_CODING_AGENT_DIR="$PI" pi remove "/home/aktersnurra/projects/vibe/superpowers"
  fi
  if grep -qF '"npm:@samfp/pi-memory"' "$SETTINGS"; then
    echo "  removing @samfp/pi-memory (conflicts with pi-hermes-memory)"
    python3 - "$SETTINGS" <<'PY'
import json
import sys

settings_path = sys.argv[1]
with open(settings_path, "r", encoding="utf-8") as f:
    settings = json.load(f)
settings["packages"] = [
    pkg for pkg in settings.get("packages", []) if pkg != "npm:@samfp/pi-memory"
]
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  fi
  if grep -qF '"npm:pi-vim"' "$SETTINGS"; then
    echo "  removing upstream pi-vim package from settings"
    python3 - "$SETTINGS" <<'PY'
import json
import sys

settings_path = sys.argv[1]
with open(settings_path, "r", encoding="utf-8") as f:
    settings = json.load(f)
settings["packages"] = [
    pkg for pkg in settings.get("packages", []) if pkg != "npm:pi-vim"
]
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  fi
fi

for pkg in "${PI_PACKAGES[@]}"; do
  if [[ -f "$SETTINGS" ]] && grep -qF "\"$pkg\"" "$SETTINGS"; then
    echo "  already installed: $pkg"
  else
    echo "  installing: $pkg"
    PI_CODING_AGENT_DIR="$PI" pi install "$pkg"
  fi
done

if command -v python3 >/dev/null 2>&1; then
  python3 - "$DOTFILES/pi.settings.json" "$SETTINGS" "$provider" <<'PY'
import json
import os
import sys

defaults_path, settings_path, provider = sys.argv[1:]

with open(defaults_path, "r", encoding="utf-8") as f:
    defaults = json.load(f)

settings = {}

if os.path.exists(settings_path):
    with open(settings_path, "r", encoding="utf-8") as f:
        content = f.read().strip()
        if content:
            settings = json.loads(content)

settings.update(defaults)
if provider:
    settings["defaultProvider"] = provider

packages = []
for package in settings.get("packages", []):
    source = package if isinstance(package, str) else package.get("source")
    if source == "npm:pi-ask-user":
        package = {"source": source} if isinstance(package, str) else dict(package)
        package["skills"] = []
    packages.append(package)
settings["packages"] = packages

os.makedirs(os.path.dirname(settings_path), exist_ok=True)
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
else
  echo "python3 is required to configure Pi settings in $SETTINGS" >&2
  exit 1
fi

if ! command -v ty >/dev/null 2>&1; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required to install ty" >&2
    exit 1
  fi
  echo "Installing ty..."
  uv tool install ty
fi

LSP_CONFIG_DIR="$HOME/.pi-lens"
mkdir -p "$LSP_CONFIG_DIR"
cp "$DOTFILES/.pi-lens/lsp.json" "$LSP_CONFIG_DIR/lsp.json"

echo "Pi configured."

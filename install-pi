#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$HOME/projects/dotagent"
PI="$HOME/.pi/agent"

mkdir -p "$PI/skills"

ln -sf "$DOTFILES/CLAUDE.md" "$PI/AGENTS.md"

for skill in "$DOTFILES/skills"/*/; do
  target="$PI/skills/$(basename "$skill")"
  rm -rf "$target"
  ln -s "$skill" "$target"
done

PI_PACKAGES=(
  "npm:@ff-labs/pi-fff"
  "npm:context-mode"
  "npm:pi-subagents"
  "npm:pi-mcp-adapter"
  "npm:pi-lens"
  "npm:@juicesharp/rpiv-ask-user-question"
  "npm:@juicesharp/rpiv-btw"
  "npm:@juicesharp/rpiv-pi"
  "npm:pi-hermes-memory"
  "git:github.com/aktersnurra/pi-vim"
  "git:github.com/aktersnurra/superpowers"
  "git:github.com/aktersnurra/no-clown-fiesta.pi@master"
)

PI_THEME="no-clown-fiesta-dark"

SETTINGS="$PI/settings.json"
echo "Installing Pi packages..."
if [[ -f "$SETTINGS" ]]; then
  if grep -qF '"npm:@casualjim/pi-superpowers"' "$SETTINGS"; then
    echo "  removing official superpowers package"
    pi remove "npm:@casualjim/pi-superpowers"
  fi
  if grep -qF '"/home/aktersnurra/projects/vibe/superpowers"' "$SETTINGS"; then
    echo "  removing local superpowers package"
    pi remove "/home/aktersnurra/projects/vibe/superpowers"
  fi
  if grep -qF '"npm:pi-vim"' "$SETTINGS"; then
    echo "  removing upstream pi-vim package from settings"
    python3 - "$SETTINGS" <<'PY'
import json
import sys

settings_path = sys.argv[1]
with open(settings_path, "r", encoding="utf-8") as f:
    settings = json.load(f)
settings["packages"] = [
    pkg for pkg in settings.get("packages", []) if pkg != "npm:pi-vim"
]
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  fi
fi

for pkg in "${PI_PACKAGES[@]}"; do
  if [[ -f "$SETTINGS" ]] && grep -qF "\"$pkg\"" "$SETTINGS"; then
    echo "  already installed: $pkg"
  else
    echo "  installing: $pkg"
    pi install "$pkg"
  fi
done

echo "Activating Pi theme: $PI_THEME"
if command -v python3 >/dev/null 2>&1; then
  python3 - "$SETTINGS" "$PI_THEME" <<'PY'
import json
import os
import sys

settings_path, theme_name = sys.argv[1], sys.argv[2]
settings = {}

if os.path.exists(settings_path):
    with open(settings_path, "r", encoding="utf-8") as f:
        content = f.read().strip()
        if content:
            settings = json.loads(content)

settings["theme"] = theme_name

os.makedirs(os.path.dirname(settings_path), exist_ok=True)
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
else
  echo "python3 is required to activate Pi theme in $SETTINGS" >&2
  exit 1
fi

echo "Pi configured."

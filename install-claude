#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$HOME/projects/dotagent"
CLAUDE="$HOME/.claude"

mkdir -p "$CLAUDE/skills"

ln -sf "$DOTFILES/CLAUDE.md" "$CLAUDE/CLAUDE.md"
ln -sf "$DOTFILES/settings.json" "$CLAUDE/settings.json"

for skill in "$DOTFILES/skills"/*/; do
  target="$CLAUDE/skills/$(basename "$skill")"
  rm -rf "$target"
  ln -s "$skill" "$target"
done

echo "Installing Claude plugins..."
claude plugins uninstall superpowers@claude-plugins-official --scope user --keep-data || true
claude plugins marketplace add https://github.com/aktersnurra/superpowers || true
claude plugins install superpowers@superpowers-dev --scope user
claude plugins install frontend-design@claude-plugins-official --scope user

echo "Claude configured."

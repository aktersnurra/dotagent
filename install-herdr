#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HERDR="${HERDR_CONFIG_DIR:-$HOME/.config/herdr}"

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr is not installed. Install it, then re-run: https://herdr.dev" >&2
  exit 1
fi

mkdir -p "$HERDR"

ln -sf "$DOTFILES/herdr/config.toml" "$HERDR/config.toml"
ln -sf "$DOTFILES/herdr/new-jj-workspace.sh" "$HERDR/new-jj-workspace.sh"
ln -sf "$DOTFILES/herdr/open-workspace.sh" "$HERDR/open-workspace.sh"
ln -sf "$DOTFILES/herdr/review-pane.sh" "$HERDR/review-pane.sh"

mkdir -p "$HERDR/plugins"
ln -sfn "$DOTFILES/herdr/plugins/next-agent" "$HERDR/plugins/next-agent"

# Linking registers the plugin's actions. Needs a running server, so skip it
# when herdr is not up; the symlink above is enough for the next launch to
# pick up once linked.
herdr plugin link "$DOTFILES/herdr/plugins/next-agent" >/dev/null 2>&1 \
  || echo "Note: run 'herdr plugin link $DOTFILES/herdr/plugins/next-agent' once herdr is running." >&2

# Without terminal-notifier, herdr's `system` toasts fall back to osascript,
# which shows up as Script Editor in Notification Center and cannot focus the
# terminal on click. macOS-only: other platforms use their own notifier.
if [[ "$(uname -s)" == "Darwin" ]] && ! command -v terminal-notifier >/dev/null 2>&1; then
  echo "Note: terminal-notifier not found. Install it for proper notification icons: brew install terminal-notifier" >&2
fi

echo "Herdr configured."
